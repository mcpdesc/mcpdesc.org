/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  X-Frame-Options: DENY
  Permissions-Policy: camera=(), microphone=(), geolocation=(), payment=()
  Cross-Origin-Opener-Policy: same-origin

# Hosted mcpdesc badge definitions consumed by shields.io endpoint badges.
# Allow cross-origin reads and cache for an hour so badge changes propagate without
# being served stale indefinitely.
/badge/*
  Content-Type: application/json; charset=utf-8
  Access-Control-Allow-Origin: *
  Cache-Control: public, max-age=3600

# Versioned MCP Description JSON Schemas are immutable. Keep these paths explicit so the
# mutable latest.json and draft.json redirects do not inherit immutable caching.
/schema/mcp-description/0.7.0.json
  Content-Type: application/schema+json; charset=utf-8
  Access-Control-Allow-Origin: *
  Cache-Control: public, max-age=31536000, immutable

/schema/mcp-description/0.8.0-rc.1.json
  Content-Type: application/schema+json; charset=utf-8
  Access-Control-Allow-Origin: *
  Cache-Control: public, max-age=31536000, immutable

/schema/mcp-description/0.8.0-rc.2.json
  Content-Type: application/schema+json; charset=utf-8
  Access-Control-Allow-Origin: *
  Cache-Control: public, max-age=31536000, immutable

/schema/mcp-description/0.8.0-rc.4.json
  Content-Type: application/schema+json; charset=utf-8
  Access-Control-Allow-Origin: *
  Cache-Control: public, max-age=31536000, immutable

/schema/mcp-description/latest.json
  Access-Control-Allow-Origin: *
  Cache-Control: public, max-age=300

/schema/mcp-description/draft.json
  Access-Control-Allow-Origin: *
  Cache-Control: public, max-age=300

# Markdown twins (Option A): a .md counterpart of every page, for AI agents.
# Serve them with the Markdown content type and allow cross-origin reads.
/*.md
  Content-Type: text/markdown; charset=utf-8
  Access-Control-Allow-Origin: *

# First-party single-file specification bundles + machine-readable version index.
# Fully specify each rule (content type, CORS, caching) so behaviour does not depend
# on how Cloudflare merges the broader /*.md and /* rules above.
#
# The version index changes whenever a new version ships — cache briefly.
/specification/index.json
  Content-Type: application/json; charset=utf-8
  Access-Control-Allow-Origin: *
  Cache-Control: public, max-age=300

# The `latest` alias is mutable (it re-points when a new version ships): cache
# briefly and allow stale-while-revalidate so agents still get fast responses.
/specification/latest/*
  Content-Type: text/markdown; charset=utf-8
  Access-Control-Allow-Origin: *
  Cache-Control: public, max-age=300, stale-while-revalidate=3600

# Versioned bundles are stable but not strictly frozen — we may regenerate a
# released version's bundle (e.g. formatting fixes or a content re-import). So
# cache for a week rather than marking it `immutable`, giving caches and agents a
# bounded, predictable window in which a regeneration will propagate.
# NOTE: add a matching rule for each new version bundle (e.g. /specification/0.8.0/*).
/specification/0.7.0/*
  Content-Type: text/markdown; charset=utf-8
  Access-Control-Allow-Origin: *
  Cache-Control: public, max-age=604800, stale-while-revalidate=86400

/specification/0.8.0-rc.4/*
  Content-Type: text/markdown; charset=utf-8
  Access-Control-Allow-Origin: *
  Cache-Control: public, max-age=604800, stale-while-revalidate=86400
