/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  X-Frame-Options: DENY
  Permissions-Policy: camera=(), microphone=(), geolocation=(), payment=()
  Cross-Origin-Opener-Policy: same-origin

# Hosted mcpdesc badge definitions consumed by shields.io endpoint badges.
# Allow cross-origin reads and cache for an hour so badge changes propagate without
# being served stale indefinitely.
/badge/*
  Content-Type: application/json; charset=utf-8
  Access-Control-Allow-Origin: *
  Cache-Control: public, max-age=3600

# Markdown twins (Option A): a .md counterpart of every page, for AI agents.
# Serve them with the Markdown content type and allow cross-origin reads.
/*.md
  Content-Type: text/markdown; charset=utf-8
  Access-Control-Allow-Origin: *

# First-party single-file specification bundles + machine-readable version index.
# The per-version mcpdesc.md bundles are already served as text/markdown by the
# /*.md rule above; here we allow cross-origin reads of the JSON manifest so AI
# assistants and build tools can fetch it from any origin.
/specification/index.json
  Content-Type: application/json; charset=utf-8
  Access-Control-Allow-Origin: *
