---
import DefaultPageTitle from '@astrojs/starlight/components/PageTitle.astro';

const entry = Astro.locals.starlightRoute.entry;
const { ruleSurface } = entry.data;
const hasRuleMarkers = entry.body?.includes('mcpdesc-rule-links') ?? false;
---

<div class="page-title-bar">
  <div class:list={{ 'rule-title': Boolean(ruleSurface) }}><DefaultPageTitle /></div>
  {hasRuleMarkers && <button class="rule-visibility-toggle" type="button" aria-pressed="true" data-rule-visibility-toggle>Hide rules</button>}
</div>

{hasRuleMarkers && <script>
  document.addEventListener('click', (event) => {
    if (!(event.target instanceof Element)) return;
    const button = event.target.closest('[data-rule-visibility-toggle]');
    if (!(button instanceof HTMLButtonElement)) return;

    const visible = button.getAttribute('aria-pressed') !== 'true';
    document.documentElement.classList.toggle('rules-hidden', !visible);
    button.setAttribute('aria-pressed', String(visible));
    button.textContent = visible ? 'Hide rules' : 'Show rules';
  });
</script>}

<style>
  .page-title-bar {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: 1rem;
  }

  .page-title-bar > :first-child {
    min-width: 0;
  }

  .rule-visibility-toggle {
    flex: none;
    margin-top: 0.25rem;
    border: 1px solid var(--sl-color-gray-5);
    border-radius: 0.25rem;
    background: var(--sl-color-bg);
    color: var(--sl-color-text);
    padding: 0.35rem 0.6rem;
    font: inherit;
    font-size: var(--sl-text-sm);
    cursor: pointer;
  }

  .rule-visibility-toggle:hover {
    background: var(--sl-color-gray-6);
  }

  .rule-visibility-toggle:focus-visible {
    outline: 2px solid var(--sl-color-text-accent);
    outline-offset: 2px;
  }

  .rule-title :global(h1) {
    font-size: var(--sl-text-2xl);
    line-height: 1.4;
    overflow-wrap: anywhere;
  }

  @media (max-width: 35rem) {
    .page-title-bar {
      flex-wrap: wrap;
    }
  }
</style>