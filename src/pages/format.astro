---
import BaseLayout from '../layouts/BaseLayout.astro';
import { Code } from 'astro:components';

const specVersion = '0.9.0';
const specStatus = 'Stable';

const exampleYaml = `mcpdesc: 0.9.0
info:
  name: chess-rating-server
  title: Chess Rating MCP Server
  version: 2.1.0
protocolVersions:
  - "2026-07-28"
transports:
  - type: stdio
    command: chess-rating
    args:
      - serve
tools:
  - name: get_player_rating
    description: Get the current FIDE standard rating for a chess player
    inputSchema:
      type: object
      properties:
        player_id:
          description: FIDE player identifier
          type: string
      required:
        - player_id
    outputSchema:
      type: integer
      description: Current FIDE standard rating`;

const exampleJson = `{
  "mcpdesc": "0.9.0",
  "info": {
    "name": "chess-rating-server",
    "title": "Chess Rating MCP Server",
    "version": "2.1.0"
  },
  "protocolVersions": ["2026-07-28"],
  "transports": [
    {
      "type": "stdio",
      "command": "chess-rating",
      "args": ["serve"]
    }
  ],
  "tools": [
    {
      "name": "get_player_rating",
      "description": "Get the current FIDE standard rating for a chess player",
      "inputSchema": {
        "type": "object",
        "properties": {
          "player_id": {
            "description": "FIDE player identifier",
            "type": "string"
          }
        },
        "required": ["player_id"]
      },
      "outputSchema": {
        "type": "integer",
        "description": "Current FIDE standard rating"
      }
    }
  ]
}`;
---

<BaseLayout
  title="MCP Description - mcpdesc"
  description="MCP Description is a portable, machine-readable format for what an MCP server offers — Think OpenAPI, but for the Model Context Protocol."
  pageType="format"
>
  <section class="py-10 text-center">
    <h1 class="text-3xl font-bold tracking-tight sm:text-4xl">MCP Description - 'mcpdesc'</h1>
    <p class="mx-auto mt-4 max-w-2xl text-lg text-slate-600 dark:text-slate-300">
      A portable, machine-readable format for describing what an MCP server offers — its tools,
      resources, prompts, transports, and security — declared in a single static
      document. Think OpenAPI, but for the Model Context Protocol.
    </p>

    <div class="mt-8 flex flex-wrap items-center justify-center gap-3">
      <a
        href="/docs/specification/0.9.0/"
        data-analytics-cta="read_spec"
        class="inline-block rounded-md bg-[var(--color-brand)] px-6 py-3 text-lg font-medium text-white hover:bg-[var(--color-brand-dark)]"
      >
        Read the specification
      </a>
      <a
        href="/live-editor"
        data-analytics-cta="open_editor"
        class="inline-block rounded-md border border-slate-300 px-6 py-3 text-lg font-medium text-slate-800 hover:border-slate-400 dark:border-slate-700 dark:text-slate-100"
      >
        Try it in the Editor
      </a>
    </div>
    <p class="mx-auto mt-4 max-w-2xl text-sm text-slate-500">
      {specVersion} · {specStatus}
    </p>
    <p class="mt-3 text-sm">
      <a class="font-medium text-[var(--color-brand)] hover:underline" href="#complementary-roles">
        How MCP, Server Cards, and MCP Description fit together
      </a>
    </p>
  </section>

  <section class="mt-12">
    <h2 class="text-2xl font-bold tracking-tight">Define. Validate. Evolve.</h2>
    <p class="mt-3 max-w-3xl text-slate-600 dark:text-slate-300">
      An MCP Description is a versioned engineering artifact that teams can review and share
      independently of a running server. Compatible tools can use it throughout the lifecycle:
    </p>
    <ol class="mt-8 grid gap-6 md:grid-cols-3 md:gap-8">
      <li class="relative text-center">
        <svg class="mx-auto h-6 w-6 text-slate-500 dark:text-slate-400" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="M12 19 5 12l-2 2 7 7h3v-3l8-8-3-3-8 8" />
          <path d="m18 4 2-2 3 3-2 2M2 21l4-1-3-3-1 4ZM7 7l3-3 10 10-3 3M5 9 2 6l4-4 3 3" />
        </svg>
        <h3 class="mt-3 text-lg font-bold">Define</h3>
        <p class="mt-2 text-sm text-slate-600 dark:text-slate-300">Declare the server's intended interface and supporting metadata.</p>
        <svg class="mx-auto mt-5 h-5 w-5 rotate-90 text-slate-400 md:absolute md:-right-6 md:top-1 md:mt-0 md:rotate-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="M5 12h14m-6-6 6 6-6 6" />
        </svg>
      </li>
      <li class="relative text-center">
        <svg class="mx-auto h-6 w-6 text-slate-500 dark:text-slate-400" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="M12 22s8-4 8-11V5l-8-3-8 3v6c0 7 8 11 8 11Z" />
          <path d="m9 12 2 2 4-4" />
        </svg>
        <h3 class="mt-3 text-lg font-bold">Validate</h3>
        <p class="mt-2 text-sm text-slate-600 dark:text-slate-300">Check descriptions and assess server conformance with compatible tools.</p>
        <svg class="mx-auto mt-5 h-5 w-5 rotate-90 text-slate-400 md:absolute md:-right-6 md:top-1 md:mt-0 md:rotate-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="M5 12h14m-6-6 6 6-6 6" />
        </svg>
      </li>
      <li class="text-center">
        <svg class="mx-auto h-6 w-6 text-slate-500 dark:text-slate-400" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <circle cx="6" cy="18" r="3" />
          <circle cx="18" cy="6" r="3" />
          <path d="M6 15V3m12 6a9 9 0 0 1-9 9" />
        </svg>
        <h3 class="mt-3 text-lg font-bold">Evolve</h3>
        <p class="mt-2 text-sm text-slate-600 dark:text-slate-300">Compare changes and govern the interface across releases.</p>
      </li>
    </ol>
  </section>

  <section class="mt-12">
    <h2 class="text-2xl font-bold tracking-tight">A basic example</h2>
    <p class="mt-3 max-w-3xl text-slate-600 dark:text-slate-300">
      An MCP Description can be written in YAML or JSON. This example describes a server,
      its transport, and a tool for looking up a player's rating.
    </p>
    <div class="mt-4" data-example-tabs>
      <div
        class="flex gap-1 border-b border-slate-200 dark:border-slate-800"
        role="tablist"
        aria-label="Example format"
      >
        <button
          type="button"
          role="tab"
          aria-selected="true"
          data-example-tab="yaml"
          class="-mb-px border-b-2 border-transparent px-4 py-2 text-sm font-medium text-[#8c7060] hover:text-[#5c4030] aria-selected:border-[var(--color-brand)] aria-selected:text-slate-900 dark:text-slate-400 dark:hover:text-slate-200 dark:aria-selected:text-white"
        >
          YAML
        </button>
        <button
          type="button"
          role="tab"
          aria-selected="false"
          data-example-tab="json"
          class="-mb-px border-b-2 border-transparent px-4 py-2 text-sm font-medium text-[#8c7060] hover:text-[#5c4030] aria-selected:border-[var(--color-brand)] aria-selected:text-slate-900 dark:text-slate-400 dark:hover:text-slate-200 dark:aria-selected:text-white"
        >
          JSON
        </button>
      </div>
      <div data-example-panel="yaml" class="example-panel overflow-x-auto rounded-b-lg text-sm">
        <Code code={exampleYaml} lang="yaml" theme="github-light" />
      </div>
      <div
        data-example-panel="json"
        hidden
        class="example-panel overflow-x-auto rounded-b-lg text-sm"
      >
        <Code code={exampleJson} lang="json" theme="github-light" />
      </div>
    </div>
    <p class="mt-3 text-sm">
      <a
        class="font-medium text-[var(--color-brand)] hover:underline"
        href="https://editor.mcpdesc.org/?example=basic"
        data-analytics-cta="open_editor">Open the basic example in the Live Editor →</a
      >
    </p>
  </section>

  <section class="mt-12">
    <h2 class="text-2xl font-bold tracking-tight">Generate an MCP description from a live server</h2>
    <p class="mt-3 max-w-3xl text-slate-600 dark:text-slate-300">
      Point the <code>mcpcontract</code> CLI at any MCP server to produce an <code>mcpdesc</code> document you can open in the editor:
    </p>
    <pre class="mt-3 overflow-x-auto rounded-md bg-slate-900 p-4 text-sm text-slate-100"><code>mcpcontract dump \
  --transport streamable-http \
  --url "https://your-server.example/mcp" \
  --protocol auto \
  --format yaml \
  --output server.mcpdesc.yaml</code></pre>
    <p class="mt-3 text-sm">
      <a
        class="font-medium text-[var(--color-brand)] hover:underline"
        href="/docs/getting-started/#run-your-first-dump"
        data-analytics-cta="read_docs">Read the docs →</a
      >
    </p>
  </section>

    <section id="complementary-roles" class="mt-12 scroll-mt-24">
    <h2 class="text-2xl font-bold tracking-tight">Three complementary roles in the MCP ecosystem</h2>
    <p class="mt-3 max-w-3xl text-slate-600 dark:text-slate-300">
      MCP standardizes runtime interactions, Server Cards support pre-connection discovery,
      and MCP Description supports engineering and governance throughout the server lifecycle.
    </p>
    <div class="mt-6 grid gap-6 md:grid-cols-3">
      <div class="border-t-2 border-slate-300 pt-4 dark:border-slate-700">
        <p class="text-sm font-semibold text-[var(--color-brand)]">Runtime</p>
        <h3 class="mt-1 text-lg font-bold">MCP Protocol</h3>
        <p class="mt-1 text-sm font-medium text-slate-600 dark:text-slate-300">Interact with a server</p>
        <p class="mt-3 text-sm text-slate-600 dark:text-slate-300">
          Standardizes how MCP clients and servers communicate, discover capabilities, and
          interact with tools, resources, and prompts at runtime.
        </p>
        <p class="mt-3 text-sm text-slate-600 dark:text-slate-300">
          <strong>Enables:</strong> Dynamic capability discovery and interoperable client-server interactions.
        </p>
        <p class="mt-3 text-sm text-slate-600 dark:text-slate-300">
          <strong>Key question:</strong> How do clients and servers interact?
        </p>
      </div>
      <div class="border-t-2 border-slate-300 pt-4 dark:border-slate-700">
        <p class="text-sm font-semibold text-[var(--color-brand)]">Discovery</p>
        <h3 class="mt-1 text-lg font-bold">MCP Server Card</h3>
        <p class="mt-1 text-sm font-medium text-slate-600 dark:text-slate-300">Find and connect</p>
        <p class="mt-3 text-sm text-slate-600 dark:text-slate-300">
          An optional MCP extension, currently experimental, for describing a remote server's
          identity, connection endpoints, and supported protocol versions before connecting.
        </p>
        <p class="mt-3 text-sm text-slate-600 dark:text-slate-300">
          <strong>Enables:</strong> Pre-connection discovery, server identification, and
          automated connection setup.
        </p>
        <p class="mt-3 text-sm text-slate-600 dark:text-slate-300">
          <strong>Key question:</strong> What is this server, and how do I connect to it?
        </p>
      </div>
      <div class="border-t-2 border-slate-300 pt-4 dark:border-slate-700">
        <p class="text-sm font-semibold text-[var(--color-brand)]">Lifecycle engineering</p>
        <h3 class="mt-1 text-lg font-bold">MCP Description (<code>mcpdesc</code>)</h3>
        <p class="mt-1 text-sm font-medium text-slate-600 dark:text-slate-300">Design and Implement</p>
        <p class="mt-3 text-sm text-slate-600 dark:text-slate-300">
          A portable, versioned, machine-readable description of an MCP server's intended interface,
          including tools, resources, prompts, schemas, and supporting metadata.
        </p>
        <p class="mt-3 text-sm text-slate-600 dark:text-slate-300">
          <strong>Supports:</strong> Server design and implementation, and tools for documentation,
          validation, mocking, testing, change detection, and governance across releases.
        </p>
        <p class="mt-3 text-sm text-slate-600 dark:text-slate-300">
          <strong>Key question:</strong> How do we define, build, validate, and evolve this
          server's interface?
        </p>
      </div>
    </div>
    <p class="mt-6 max-w-3xl text-slate-600 dark:text-slate-300">
      Server Cards omit tool, resource, and prompt definitions. MCP Description provides a
      static, curated declaration that complements runtime discovery; it does not guarantee
      what a particular user or session can access.
      <a class="font-medium text-[var(--color-brand)] hover:underline" href="/docs/faq/#server-cards-exclude-primitives--why-does-mcpdesc-describe-them">Learn more in the FAQ</a>.
    </p>
  </section>

  <section id="mcp-security" class="mt-12 scroll-mt-24">
    <h2 class="text-2xl font-bold tracking-tight">Complementary roles in MCP security</h2>
    <p class="mt-3 max-w-3xl text-slate-600 dark:text-slate-300">
      MCP Description makes statically known authentication and authorization requirements
      explicit, including the scopes expected for individual tools, resources, and prompts.
      It complements discovery and runtime enforcement rather than replacing them.
    </p>
    <dl class="mt-6 grid gap-5 sm:grid-cols-2 lg:grid-cols-4">
      <div class="border-t-2 border-slate-300 pt-3 dark:border-slate-700">
        <dt class="font-bold">MCP Server Card</dt>
        <dd class="mt-1 text-sm text-slate-600 dark:text-slate-300">Optional server and connection discovery</dd>
      </div>
      <div class="border-t-2 border-slate-300 pt-3 dark:border-slate-700">
        <dt class="font-bold">OAuth discovery</dt>
        <dd class="mt-1 text-sm text-slate-600 dark:text-slate-300">Discover authorization servers and their capabilities</dd>
      </div>
      <div class="border-t-2 border-[var(--color-brand)] pt-3">
        <dt class="font-bold">MCP Description</dt>
        <dd class="mt-1 text-sm text-slate-600 dark:text-slate-300">Describe expected access requirements</dd>
      </div>
      <div class="border-t-2 border-slate-300 pt-3 dark:border-slate-700">
        <dt class="font-bold">Runtime authorization</dt>
        <dd class="mt-1 text-sm text-slate-600 dark:text-slate-300">Validate credentials and enforce access</dd>
      </div>
    </dl>
    <p class="mt-6 max-w-3xl text-slate-600 dark:text-slate-300">
      These are complementary responsibilities, not mandatory sequential steps.{' '}
      <a class="font-medium text-[var(--color-brand)] hover:underline" href="/docs/guide-relationship-to-mcp-security/">Explore the relationship to MCP security</a>.
    </p>
  </section>

</BaseLayout>

<script>
  function initExampleTabs() {
    document.querySelectorAll<HTMLElement>('[data-example-tabs]').forEach((root) => {
      const tabs = root.querySelectorAll<HTMLButtonElement>('[data-example-tab]');
      const panels = root.querySelectorAll<HTMLElement>('[data-example-panel]');
      tabs.forEach((tab) => {
        tab.addEventListener('click', () => {
          const key = tab.dataset.exampleTab;
          tabs.forEach((t) => t.setAttribute('aria-selected', String(t === tab)));
          panels.forEach((p) => {
            p.hidden = p.dataset.examplePanel !== key;
          });
        });
      });
    });
  }

  initExampleTabs();
  document.addEventListener('astro:page-load', initExampleTabs);
</script>

<style>
  .example-panel :global(pre) {
    margin: 0;
    padding: 1rem;
    border-radius: 0 0 0.5rem 0.5rem;
    background-color: #ffffff !important; /* white */
  }
</style>
